# Local workflows need no credentials. Never copy a funded .env or usage ledger between checkouts.
# Copy to .env privately; the server loads only its own working directory configuration.
NEBIUS_API_KEY=
NEBIUS_MODEL_ID=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
TAVILY_API_KEY=
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=aura-2-thalia-en

# Default deny. Verify sufficient free credits and provider stop-at-limit/no-card settings first.
# Confirmation expires after 24 hours. Limits count attempts, not dollars; failed calls consume slots.
# These flags cannot disable provider billing. Preserve work/free-usage across restarts.
# Use the same absolute ledger path for all four apps on one funded account.
# Leaving this blank uses this checkout only; never duplicate an account allowance across clones.
FREE_USAGE_LEDGER_DIR=
NEBIUS_TOKEN_FACTORY_FREE_ONLY_CONFIRMED=false
NEBIUS_TOKEN_FACTORY_FREE_VERIFIED_AT=
NEBIUS_TOKEN_FACTORY_FREE_REQUEST_LIMIT=
TAVILY_FREE_ONLY_CONFIRMED=false
TAVILY_FREE_VERIFIED_AT=
TAVILY_FREE_REQUEST_LIMIT=
DEEPGRAM_FREE_ONLY_CONFIRMED=false
DEEPGRAM_FREE_VERIFIED_AT=
DEEPGRAM_FREE_REQUEST_LIMIT=
